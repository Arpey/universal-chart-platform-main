PORT=3001
CORS_ORIGIN=http://localhost:5173

# ===== Binance datasource (default) =====
# USDT-M perpetual futures (default Binance)
# BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
# BINANCE_FUTURES_WS_URL=wss://fstream.binance.com/ws
# Spot (optional)
# BINANCE_BASE_URL=https://api.binance.com
# BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# ===== Tradovate datasource (Lucid eval account / US index futures) =====
# env: live (real / Lucid eval) or demo (paper)
#   live -> https://live.tradovateapi.com/v1  + wss://md.tradovateapi.com/v1/websocket
#   demo -> https://demo.tradovateapi.com/v1  + wss://demo-md.tradovateapi.com/v1/websocket
# Lucid eval accounts: no API key, use username + password directly.
# appId/appVersion fixed to ChartPlatform / 1.0.0, cid=0, sec="".
# NOTE: fill real credentials into backend/.env (NOT this template file).
TRADOVATE_ENV=live
TRADOVATE_USER=
TRADOVATE_PASSWORD=

# ===== TradeFi whitelist (Binance USDT-M contracts) =====
# 'tradefi' source category: only these symbols are shown/allowed.
# Comma-separated, e.g. tokenized gold/silver + US stocks.
TRADEFI_SYMBOLS=XAUUSDT,XAGUSDT,NVDAUSDT,TSLAUSDT,AMZNUSDT,AVGOUSDT,INTCUSDT,IBMUSDT,UBERUSDT,BABAUSDT,SOXLUSDT,SQQQUSDT
# When true, also hide these symbols from the full 'binance' list.
HIDE_TRADEFI_IN_BINANCE=false   # optional, hide tradefi symbols in the full/all mode

# ===== Local proxy =====
# Local proxy (V2rayN/Clash etc.), default http://127.0.0.1:10808
HTTPS_PROXY=http://127.0.0.1:10808

# ===== IBKR datasource (Interactive Brokers / CME futures) =====
# Local IB Gateway / TWS API connection.
# 4002 is the default IB Gateway (paper/simulated) port; TWS live port is 7496.
# Delayed market data (free, no market data subscription needed) is enabled
# automatically right after connecting (MarketDataType.DELAYED = 3).
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=10
IBKR_ENABLED=true
