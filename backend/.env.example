PORT=3001
CORS_ORIGIN=http://localhost:5173

# ===== Binance datasource (default) =====
# USDT-M perpetual futures (default Binance)
# BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
# BINANCE_FUTURES_WS_URL=wss://fstream.binance.com/ws
# Spot (optional)
# BINANCE_BASE_URL=https://api.binance.com
# BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# ===== Tradovate datasource (Lucid eval account / US index futures) =====
# env: live (real / Lucid eval) or demo (paper)
#   live -> https://live.tradovateapi.com/v1  + wss://md.tradovateapi.com/v1/websocket
#   demo -> https://demo.tradovateapi.com/v1  + wss://demo-md.tradovateapi.com/v1/websocket
# Lucid eval accounts: no API key, use username + password directly.
# appId/appVersion fixed to ChartPlatform / 1.0.0, cid=0, sec="".
# NOTE: fill real credentials into backend/.env (NOT this template file).
TRADOVATE_ENV=live
TRADOVATE_USER=
TRADOVATE_PASSWORD=

# ===== TradeFi whitelist (Binance USDT-M contracts) =====
# 'tradefi' source category: only these symbols are shown/allowed.
# Comma-separated. NOTE: unset/empty -> falls back to the built-in preset list in
# src/utils/config.ts (SPX index, gold/silver/copper, US equity perps like NVDA/TSLA).
# Symbols not actually listed on fapi.binance.com are auto-filtered out by exchangeInfo.
TRADEFI_SYMBOLS=SPXUSDT,XAUUSDT,XAGUSDT,COPPERUSDT,XAUTUSDT,PAXGUSDT,NVDAUSDT,TSLAUSDT,AAPLUSDT,MSFTUSDT,AMZNUSDT,METAUSDT,AVGOUSDT,INTCUSDT,IBMUSDT,UBERUSDT,BABAUSDT,SOXLUSDT,SQQQUSDT,COINUSDT,MSTRUSDT,PLTRUSDT,ORCLUSDT,QCOMUSDT,AMDUSDT,NFLXUSDT,SHOPUSDT
# When true, also hide these symbols from the full 'binance' list.
HIDE_TRADEFI_IN_BINANCE=false   # optional, hide tradefi symbols in the full/all mode

# ===== Local proxy =====
# Local proxy (V2rayN/Clash etc.), default http://127.0.0.1:10808
HTTPS_PROXY=http://127.0.0.1:10808

# ===== IBKR datasource (Interactive Brokers / CME futures) =====
# Local IB Gateway / TWS API connection.
# 4002 is the default IB Gateway (paper/simulated) port; TWS live port is 7496.
# Market data type requested right after connecting (IBKR_MARKET_DATA_TYPE):
#   realtime (default, MarketDataType=1 -> real-time ticks + 5s real-time bars;
#             requires an active CME Globex live market data subscription)
#   frozen (2) | delayed (3, free but ~10 min delayed on CME) | delayed-frozen (4)
# If live data is requested but not entitled (IB error 10167/354/10197), the backend
# automatically falls back to delayed data, so no manual switching is needed
# (set IBKR_FALLBACK_DELAYED=false to disable the fallback).
# Triage: GET /api/ibkr/status returns the type actually in effect (1 = live, 3 = delayed).
IBKR_HOST=127.0.0.1
IBKR_PORT=4001
# IBKR_CLIENT_ID: the backend keeps exactly ONE global IBKR connection (IBKRClient singleton) and
# reuses this fixed client id forever. Never random: a random id per restart adds one more entry to
# the TWS/IB Gateway "API clients" list on every restart.
# Defaults to 1 when unset; set another free id here if 1 is already taken (InfoCode/Error 326).
IBKR_CLIENT_ID=10
IBKR_ENABLED=true
IBKR_MARKET_DATA_TYPE=realtime
# Minimum delay before reconnecting after a disconnect (ms, default 30000). TWS/IB Gateway needs a
# release window for the old clientId; reconnecting too fast registers yet another API client.
# IBKR_RECONNECT_DELAY_MS=30000
